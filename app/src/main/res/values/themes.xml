<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SahabTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sahab_bg</item>
        <item name="android:colorBackground">@color/sahab_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="FirebaseAppDistributionTheme" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="SahabTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sahab_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/SahabTheme</item>
    </style>

</resources>
