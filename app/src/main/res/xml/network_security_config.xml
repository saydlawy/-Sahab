<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Restrict built-in app APIs and metadata hosts strictly to HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">themoviedb.org</domain>
        <domain includeSubdomains="true">tmdb.org</domain>
        <domain includeSubdomains="true">goal-api.com</domain>
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">open-meteo.com</domain>
        <domain includeSubdomains="true">ipwho.is</domain>
    </domain-config>

    <!-- Allow user-supplied IPTV portal & stream hosts that still operate over HTTP;
         app-level OkHttp guard & LoginScreen warning restrict cleartext to active IPTV hosts. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
